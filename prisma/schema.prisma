generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String   @id @default(cuid())
  
  // Authentication
  email            String?  @unique
  passwordHash     String?
  countryCode      String?  // e.g. +853, +86
  phoneNumber      String?  @unique
  authType         String   @default("EMAIL") // "EMAIL", "PHONE", "DUAL"
  sessionToken     String?  // To enforce single active login session
  
  // Preferences & Roles
  languagePref     String   @default("EN")    // "EN", "ZH_HK", "ZH_CN"
  role             String   @default("LEARNER") // "ADMIN", "EDUCATOR", "LEARNER"
  
  // Profile Info
  name             String?
  
  // Student Specific
  studentId        String?  @unique
  mustChangePassword Boolean @default(false)
  
  // Trial Logic
  createdAt        DateTime @default(now())
  trialExpiresAt   DateTime

  // Economy
  tokens           Int      @default(0)

  // Relationships
  coursesTaught    Course[] @relation("EducatorCourses")
  enrollments      Enrollment[]
  transactions     Transaction[]

  // Messages
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Course {
  id             String       @id @default(cuid())
  title          String
  description    String
  educatorId     String
  isSynced       Boolean      @default(false)
  isActive       Boolean      @default(false)
  currentSlide   Int          @default(0)
  publishedSlide Int          @default(0)
  createdAt      DateTime     @default(now())
  startedAt      DateTime?
  isArchived     Boolean      @default(false)
  
  // Marketplace & Quotas
  isPublic       Boolean      @default(false)
  priceTokens    Int          @default(10) // Price per student in tokens
  studentQuota   Int          @default(30) // DIY default = 30 free
  clonedFromId   String?      // If purchased/shared from another course
  sharedQuotaGroupId String?  // Optional: points to the root Course ID whose quota is shared
  
  htmlContent    String?      // Stores the raw HTML content of the course
  
  educator       User         @relation("EducatorCourses", fields: [educatorId], references: [id])
  enrollments    Enrollment[]
}

model Enrollment {
  id           String    @id @default(cuid())
  userId       String
  courseId     String
  status       String    @default("PENDING") // PENDING, APPROVED
  lastSeenAt   DateTime?
  currentSlide Int?      @default(0)
  pcId         String?   // Mapped PC ID for this specific class

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // Positive = bought/earned, Negative = spent
  description String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}
